t=ti.field(dtype=ti.f32,shape=())

tW=diskOR*2*256

texture=ti.field(ti.f32,shape=(tW,tW))
@ti.kernel
def createTexture():
    for x,y in ti.ndrange(tW,tW):
        posNorm=ti.Vector([x,y])/tW
        v=0.0
        maxV=0.0
        amp=1.0
        for o in range(noiseOctaves):
            gridSize=f0inv*1<<o
            gridIdx=ti.Vector([ti.int32(0),ti.int32(0)])
            gridPos=posNorm*gridSize
            gridIdx=ti.cast(ti.floor(gridPos),ti.int32)
            lowestR=(pointPos[o,gridIdx[0],gridIdx[1]]-gridPos).norm()
            k=0
            l=0
            for k0 in range(3):
                k=k0-1
                for l0 in range(3):
                    l=l0-1
                    gx=gridIdx[0]+k
                    gy=gridIdx[1]+l 
                    gx=ti.max(ti.min(gridSize,gx),0)
                    gy=ti.max(ti.min(gridSize,gy),0)
                    r=pointPos[o,gx,gy]-gridPos
                    lowestR=ti.min(r.norm(),lowestR)
            v+=amp*lowestR
            amp/=am
            maxV+=amp
        texture[x,y]=ti.max(0,maxV-v)
    for x,y in ti.ndrange(screenW,screenH):
        z=0.0
        for i in range(noiseP):
            z+=(ti.random()+1)/2
        rayNoise[x+y*screenW]=noiseAmp*z/noiseP

@ti.func
def passDiskPlane(y0,y1):
    q=False
    if y0*y1<=0:
        q=True
    return q
@ti.func
def checkHit(pos0,pos1):
    x0=pos0[0]
    y0=pos0[1]
    z0=pos0[2]
    x1=pos1[0]
    y1=pos1[1]
    z1=pos1[2]
    q=-1
    x=0.0
    z=0.0
    if passDiskPlane(y0,y1): #passes plane
        W=y0/(y0-y1)
        x=x0+W*(x1-x0)
        z=z0+W*(z1-z0)
        r=x*x+z*z
        q=0
        if r>diskIR2 and r<diskOR2: #hit
            q=1
    return ti.Vector([q,x,z])


@ti.kernel
def rayInit():
    cam=ti.Vector([camR[None]*ti.cos(theta[None]),camR[None]*ti.sin(theta[None]),0.0])
    center=ti.Vector([0.0,0.0,0.0])

    forward=(center-cam).normalized()

    worldUp=ti.Vector([0.0,1.0,0.0])
    right=forward.cross(worldUp).normalized()
    if ti.cos(theta[None])<0:
        right=-right
    up=right.cross(forward).normalized()

    aspect=ti.cast(screenW, ti.f32) / ti.cast(screenH, ti.f32)
    scale=0.7

    for i in range(rayCount):
        px=i%screenW
        py=i//screenW
        u=(ti.cast(px, ti.f32)+0.5)/ti.cast(screenW, ti.f32)*2-1
        v=(ti.cast(py, ti.f32)+0.5)/ti.cast(screenH, ti.f32)*2 -1
        u*=aspect*scale
        v*=scale
        rayToPixel[i] = ti.Vector([px, py])
        rayPos[i]=cam
        rayDir[i]=(forward+ right*u + up*v).normalized()
        rayKill[i]=0


f0inv=int(1/f0)
mgs=f0inv*(1<<(noiseOctaves-1))
pointPos=ti.Vector.field(2,dtype=ti.f32,shape=(noiseOctaves,mgs,mgs))

@ti.kernel
def initPoints(o: ti.int32):
    gridSize=f0inv*1<<o
    for x,y in ti.ndrange(gridSize, gridSize):
        x0=ti.random()
        y0=ti.random()
        pointPos[o,x,y]=ti.Vector([x0+x,y0+y])

def initPointsController():
    for o in range(noiseOctaves):
        initPoints(o)

initPointsController()

@ti.func
def sinh(x: ti.f32) -> ti.f32:
    y=ti.exp(x)-ti.exp(-x)
    y/=2
    return y

@ti.func
def rotationFunc(r: ti.f32) -> ti.f32:
    c=(diskOR+diskIR)/2
    #x=(a-r)/(r-b) - ti.pow((r-ti.sqrt(b)),2)/c
    x=sinh(r/c-1)
    return twirl*x

@ti.func
def brightnessFunc(r: ti.f32) -> ti.f32:
    x=16*ti.pow(r-diskIR,2)*ti.pow(r-diskOR,2)/ti.pow(diskOR-diskIR,4)
    return x

@ti.func
def getDopplerFreq(pos: ti.types.vector(3,dtype=ti.f32), rayDir: ti.types.vector(3,dtype=ti.f32)) -> ti.f32:
    x=pos[0]
    y=pos[1]
    z=pos[2]
    r=ti.sqrt(x*x + z*z + y*y)
    beta= ti.sqrt(M/r)
    beta= ti.min(beta, 0.999)
    vx=-z/r *beta
    vz=x/r *beta
    dx=-rayDir[0]
    dy=-rayDir[1]
    dz=-rayDir[2]
    l=ti.sqrt(dx*dx + dy*dy + dz*dz)
    betaD=(vx*dx + vz*dz) /l
    D=ti.sqrt(1.0-beta*beta) /(1.0-betaD)

    return D

@ti.kernel
def rayLoop():
    for i in range(rayCount):
        h=rayPos[i].cross(rayDir[i])
        h2=h.dot(h)
        pos=rayPos[i]
        passed=0
        q=0
        px=rayToPixel[i]
        pxX=px[0]
        pxZ=px[1]
        S=maxSteps
        rinv=pos.norm_inv()
        dt=dtau/(rinv)
        opacity=1.0
        pos+=rayDir[i]*rayNoise[i]*(pos.norm()/diskOR)*dt
        for s in range(S):
            pos0=pos
            rinv=pos0.norm_inv()
            dt=dtau/(rinv)
            r2inv=rinv*rinv
            a=-pos0*(3*M*h2)*(r2inv*r2inv*rinv)
            rayDir[i]+=a*dt
            rayDir[i]=rayDir[i].normalized()
            pos=pos0+rayDir[i]*dt
            w=checkHit(pos0,pos)
            q=w[0]
            xi=pos[0]
            zi=pos[2]
            if passDiskPlane(pos0[1],pos[1]):
                passed+=1
            if pos.norm_sqr()>diskOR2*8:
                rayKill[i]=1
            rho=pos[0]*pos[0]+pos[2]*pos[2]
            if ti.abs(pos[1])<height and rho>diskIR2 and rho<diskOR2:
                rayKill[i]=1
                p2d=ti.Vector([xi,zi])
                r2d=p2d.norm()
                dTheta=rotationFunc(r2d)-t[None]
                theta=ti.atan2(p2d[1],p2d[0])
                posRotate=ti.Vector([ti.cos(theta+dTheta),ti.sin(theta+dTheta)])*r2d
                samplePos=ti.Vector([ti.cast((posRotate[0]+diskOR)/(2*diskOR) *tW,ti.int32),ti.cast((posRotate[1]+diskOR)/(2*diskOR) *tW,ti.int32)])
                v=texture[samplePos[0],samplePos[1]]
                b=brightnessFunc(ti.sqrt(xi*xi+zi*zi))
                F=getDopplerFreq(pos, rayDir[i])
                k=ti.max(0,v)*nh*b * F*F*F * (height-ti.abs(pos[1]))

                red=ti.Vector([0.8, 0.1, 0.0])
                gray=ti.Vector([0.7, 0.6, 0.5])
                blue=ti.Vector([0.2, 0.5, 1.0])
                c=gray

                if F < 1.0:
                    u=(F-0.67) /(1.0-0.67)
                    u=ti.max(0.0,ti.min(1.0,u))
                    c=red*(1.0-u) + gray*u

                else:
                    u=(F-1.0) /(1.5-1.0)
                    u=ti.max(0.0,ti.min(1.0,u))
                    c=gray*(1.0-u) + blue*u

                pixels[pxX,pxZ]+=ti.Vector([k*c[0],k*c[1],k*c[2],1])*ti.max(0,opacity)
                opacity-=k*opacity*dt
                if passed==1:
                    mainDiskRenderMask[pxX,pxZ]=ti.Vector([1,1,1,k])
                    mainDiskRenderBase[pxX,pxZ]=color
                elif passed>1:
                    lensDiskRenderMask[pxX,pxZ]=ti.Vector([1,1,1,k])
                    lensDiskRenderBase[pxX,pxZ]=color
        if rayKill[i]==1:
            horizonRender[pxX,pxZ]=ti.Vector([1,1,1,0])
        else:
            pixels[pxX,pxZ]=ti.Vector([0,0,0,1])

